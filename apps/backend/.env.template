# Tempani Medusa backend — copy to .env and fill in values.
# Never commit real secrets.

# PostgreSQL (required by Medusa v2)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/tempani

# Optional Redis (falls back to in-memory if unset)
REDIS_URL=redis://localhost:6379

# CORS
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000

# Auth secrets — generate strong random values for production
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# Public URLs
MEDUSA_URL=http://localhost:9000
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Mollie (required for live payments — leave empty to use system/manual provider locally)
MOLLIE_API_KEY=
MOLLIE_REDIRECT_URL=http://localhost:3000/checkout/payment

# Turso / libSQL (NOT used by Medusa — Medusa requires PostgreSQL.
# Kept for optional future non-commerce services.)
TURSO_DATABASE_URL=libsql://tempani-ericksonholding.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=
